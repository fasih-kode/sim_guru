APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=18743
# CIDR proxy tepercaya; kosong berarti header X-Forwarded tidak dipercaya.
APP_TRUSTED_PROXY_CIDRS=
DATABASE_URL=postgresql://sim_guru_app:REPLACE_LOCALLY@127.0.0.1:55436/sim_guru_dev?sslmode=disable
TEST_DATABASE_URL=postgresql://sim_guru_app:REPLACE_LOCALLY@127.0.0.1:55436/sim_guru_test?sslmode=disable
# Generate locally: python3 -c "import secrets; print(secrets.token_hex(32))"
CSRF_AUTH_KEY=REPLACE_WITH_64_RANDOM_HEX_DIGITS
# Opsional DEV-03E2: kosong berarti storage dan worker retensi nonaktif.
# Saat diisi, gunakan path absolut di luar repository/static; parent harus privat.
TEACHER_PHOTO_DIR=
# Root sumber SIM-GURU yang berisi go.mod dan internal/web/static; wajib bila storage aktif.
APP_REPOSITORY_ROOT=
